{
  // This repository holds every agent twice: .claude/agents/*.md (the source, for Claude Code) and
  // .github/agents/*.agent.md (generated by `npm run build`, for GitHub Copilot). VS Code reads both folders by
  // default, so Copilot's agent menu listed each one twice. Here it reads only the Copilot copies.
  "chat.agentFilesLocations": {
    ".claude/agents": false,
    ".github/agents": true
  }
}
